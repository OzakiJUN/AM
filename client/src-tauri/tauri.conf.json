{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AM",
  "version": "0.1.2",
  "identifier": "io.github.ozakijun.am",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "AM",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: ammedia: http://ammedia.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:; frame-src https://music.163.com; media-src 'self' blob: ammedia: http://ammedia.localhost ammusic: http://ammusic.localhost https://music.163.com https://*.music.126.net http://*.music.126.net"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "languages": ["SimpChinese", "English"], "displayLanguageSelector": false }
    }
  }
}
